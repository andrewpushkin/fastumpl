diagram "Shop"

package billing {
  abstract class Payment {
    +amount: Money
    +pay(): Receipt {abstract}
  }

  class CardPayment
}

class Order {
  +id: OrderId
  -lines: List<OrderLine>
  +total(): Money
}

interface Priced {
  +price(): Money
}

enum Status { New, Paid, Shipped }

# an order owns its lines
Order "1" *-- "1..*" OrderLine : contains
billing.CardPayment --|> billing.Payment
Order ..|> Priced
Order --> billing.Payment : paid by

class OrderLine

layout {
  Order               at 35, 17
  OrderLine           at 39, 39
  Priced              at 39, 0
  Status              at 70, 0
  billing.CardPayment at 2, 25
  billing.Payment     at 3, 5
}
